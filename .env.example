# Copy this file to .env and fill in your real values.
# Get these from your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Get this free from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-2.0-flash

# Required for Google Sign-In Popup
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Optional — safe to leave as default
VITE_ADMIN_EMAIL=amansingh28888@gmail.com
VITE_POINTS_PER_REPORT=10
VITE_POINTS_TO_INR_RATE=0.5
VITE_MIN_WITHDRAW_POINTS=50
